              ],
            ),
          ),
          const SizedBox(height: 32),

          // Inquiry History List (High-fidelity SQL integration display)
          Row(
            mainAxisAlignment: MainAxisAlignment.spaceBetween,
            children: [
              Text(
                'Riwayat Laporan Anda',
