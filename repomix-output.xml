    try {
      final results = await _notificationService.getNotifications(
        forceRefresh: forceRefresh,
      );
      setState(() {
        _notifs = results;
        _isLoading = false;
      });
    } catch (e) {
      setState(() {
        _isLoading = false;
      });
    }
