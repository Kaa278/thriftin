  }

  IconData _getIconData(String name) {
    switch (name) {
      case 'gavel':
        return Icons.gavel_rounded;
      case 'check_circle':
        return Icons.check_circle_outline;
      case 'local_fire_department':
        return Icons.local_fire_department;
